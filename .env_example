//Tiene que haber un archivo en la raíz llamada .env_playwright que es dónde se llamarán los valores para usar en playwright
//Si se necesitan agregar más credenciales, las vamos a ir definiendo en este espacio para ser llamadas por los diferentes test. 
//Es importante que no se adjunte información sensible dentro de los test

//URL a la que se accede
VITE_APP_URL_EVALUACION=

//URL correspondiente al landing page de mandante una vez iniciada la sesión
BASE_URL_MANDANTE=

//URL base de la API (mismo valor que VITE_API_WEBAPI del front). Debe terminar en / para que las rutas relativas del cliente se resuelvan bien
API_BASE_URL=

//Credenciales del usuario
USER_NAME=
USER_PASS=
